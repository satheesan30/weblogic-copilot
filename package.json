{
  "name": "agentci-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "fixture:1gb": "node scripts/create-large-upload-fixture.mjs",
    "fixture:1gb-over-limit": "node scripts/create-large-upload-fixture.mjs --over-limit",
    "chroma:run": "chroma run --path ./chroma-data --host localhost --port 8000",
    "litellm:install": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip litellm websockets backoff fastapi uvicorn python-multipart orjson apscheduler PyJWT cryptography boto3 email-validator fastapi-sso uvloop",
    "litellm:run": "set -a; [ -f .env.local ] && . ./.env.local; set +a; : ${LITELLM_MASTER_KEY:?Set LITELLM_MASTER_KEY in .env.local}; .venv/bin/litellm --config litellm-config.yaml --port 4000"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.0.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "chromadb": "^3.4.3",
    "lucide-react": "0.561.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.2.0"
  },
  "resolutions": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
